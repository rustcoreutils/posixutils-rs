WHITESPACE = _{ " " | "\t" | "\r" | "\\" ~ "\n" }
COMMENT    = _{ "#" ~ (!"\n" ~ ANY)* ~ (&"\n" | &EOI) }

string          = ${ "\"" ~ string_contents ~ "\"" }
string_contents = @{ string_char* }
string_char     =  {
    !("\"" | "\\") ~ ANY
  | "\\\\" | "\\" ~ ("\"" | "/" | "a" | "b" | "f" | "n" | "r" | "t" | "v")
  | "\\" ~ ASCII_DIGIT{1, 3}
}
ere             = @{ "/" ~ (("\\" ~ ANY) | (!("/" | "\n") ~ ANY))* ~ "/" }
number          = @{ decimal_float | integer }
digit           =  { ('0'..'9') }
integer         = @{ digit+ }
decimal_float   =  { (fractional_part ~ exponent? ~ float_suffix?) | (integer ~ exponent ~ float_suffix?) }
fractional_part =  { (integer? ~ "." ~ integer) | integer ~ "." }
exponent        =  { ("e" | "E") ~ sign? ~ integer }
sign            =  { "+" | "-" }
float_suffix    =  { "f" | "l" | "F" | "L" }

letter    =  { ('a'..'z') | ('A'..'Z') }
name      = @{ !(keyword | builtin_func) ~ (letter | "_") ~ (letter | "_" | digit)* }
func_name = @{ name ~ &"(" }

builtin_func = _{
    atan2
  | cos
  | sin
  | exp
  | log
  | sqrt
  | int
  | rand
  | srand
  | gsub
  | index
  | length
  | match_fn
  | split
  | sprintf
  | substr
  | sub
  | tolower
  | toupper
  | close
  | fflush
  | system
}

atan2    = { "atan2" ~ !(letter | "_" | digit) }
cos      = { "cos" ~ !(letter | "_" | digit) }
sin      = { "sin" ~ !(letter | "_" | digit) }
exp      = { "exp" ~ !(letter | "_" | digit) }
log      = { "log" ~ !(letter | "_" | digit) }
sqrt     = { "sqrt" ~ !(letter | "_" | digit) }
int      = { "int" ~ !(letter | "_" | digit) }
rand     = { "rand" ~ !(letter | "_" | digit) }
srand    = { "srand" ~ !(letter | "_" | digit) }
gsub     = { "gsub" ~ !(letter | "_" | digit) }
index    = { "index" ~ !(letter | "_" | digit) }
length   = { "length" ~ !(letter | "_" | digit) }
match_fn = { "match" ~ !(letter | "_" | digit) }
split    = { "split" ~ !(letter | "_" | digit) }
sprintf  = { "sprintf" ~ !(letter | "_" | digit) }
sub      = { "sub" ~ !(letter | "_" | digit) }
substr   = { "substr" ~ !(letter | "_" | digit) }
tolower  = { "tolower" ~ !(letter | "_" | digit) }
toupper  = { "toupper" ~ !(letter | "_" | digit) }
close    = { "close" ~ !(letter | "_" | digit) }
fflush   = { "fflush" ~ !(letter | "_" | digit) }
system   = { "system" ~ !(letter | "_" | digit) }

// A keyword is a whole word: `nextchar`, `printer` and `elsewhere` are names.
// `kw` guards each keyword literal below, so that a statement or expression
// starting with a longer name is not read as the keyword plus the rest.
keyword = @{
    ("function"
  | "continue"
  | "getline"
  | "printf"
  | "return"
  | "while"
  | "break"
  | "BEGIN"
  | "else"
  | "exit"
  | "nextfile"
  | "next"
  | "delete"
  | "print"
  | "for"
  | "END"
  | "if"
  | "do"
  | "in") ~ !(letter | "_" | digit)
}

kw = _{ &keyword }

program = { SOI ~ opt_newline ~ (item ~ terminator)* ~ item? ~ opt_newline ~ EOI }

terminator = _{ ";"? ~ "\n"* }

opt_newline = _{ "\n"* }

item = _{
    begin_action
  | end_action
  | rule
  | function_definition
}

begin_action = { "BEGIN" ~ action }
end_action   = { "END" ~ action }

rule = {
    action
  | pattern_and_action
  | normal_pattern
}

pattern_and_action = {
    normal_pattern ~ action
}

function_definition = { "function" ~ name ~ "(" ~ param_list? ~ ")" ~ opt_newline ~ action }

param_list = { name ~ ("," ~ opt_newline ~ name)* }

normal_pattern = { range_pattern | expr }
range_pattern  = { expr ~ "," ~ opt_newline ~ expr }

action = {
    "{" ~ opt_newline ~ "}"
  | "{" ~ opt_newline ~ terminated_statement* ~ unterminated_statement? ~ "}"
}

terminated_statement = _{
    action ~ opt_newline
  | t_if
  | t_while
  | t_for
  | t_foreach
  | empty_stmt
  | terminatable_statement ~ "\n" ~ opt_newline
  | terminatable_statement ~ ";" ~ opt_newline
}

t_if       =  { "if" ~ "(" ~ expr ~ ")" ~ opt_newline ~ terminated_statement ~ (!(kw ~ "else") | kw ~ "else" ~ opt_newline ~ terminated_statement) }
t_while    =  { "while" ~ "(" ~ expr ~ ")" ~ opt_newline ~ terminated_statement }
t_for      =  { "for" ~ "(" ~ for_init ~ ";" ~ for_cond ~ ";" ~ for_update ~ ")" ~ opt_newline ~ terminated_statement }
t_foreach  =  { "for" ~ "(" ~ name ~ in_op ~ name ~ ")" ~ opt_newline ~ terminated_statement }
empty_stmt = _{ ";" ~ opt_newline }

// Each clause of a `for` has a pair of its own, so the compiler can tell
// which of them are empty.
for_init   =  { simple_statement? }
for_cond   =  { expr? }
for_update =  { simple_statement? }

unterminated_statement = _{
    terminatable_statement
  | ut_if
  | ut_while
  | ut_for
  | ut_foreach
}

ut_if      = { "if" ~ "(" ~ expr ~ ")" ~ opt_newline ~ (terminated_statement ~ kw ~ "else" ~ opt_newline ~ unterminated_statement | unterminated_statement) }
ut_while   = { "while" ~ "(" ~ expr ~ ")" ~ opt_newline ~ unterminated_statement }
ut_for     = { "for" ~ "(" ~ for_init ~ ";" ~ for_cond ~ ";" ~ for_update ~ ")" ~ opt_newline ~ unterminated_statement }
ut_foreach = { "for" ~ "(" ~ name ~ in_op ~ name ~ ")" ~ opt_newline ~ unterminated_statement }

terminatable_statement = _{
    nextfile
  | next
  | break_stmt
  | continue_stmt
  | exit_stmt
  | return_stmt
  | do_while
  | simple_statement
}

do_while      = { kw ~ "do" ~ opt_newline ~ terminated_statement ~ "while" ~ "(" ~ expr ~ ")" }
next          = { kw ~ "next" }
nextfile      = { kw ~ "nextfile" }
break_stmt    = { kw ~ "break" }
continue_stmt = { kw ~ "continue" }

return_stmt = { kw ~ "return" ~ expr? }
exit_stmt   = { kw ~ "exit" ~ expr? }

simple_statement = {
    array_delete
  | print_stmt
  | expr
}

array_delete = {
    kw ~ "delete" ~ name ~ ("[" ~ expr ~ "]")?
}

print_stmt = {
    (printf_call | simple_printf | print_call | simple_print) ~ output_redirection?
}

simple_print       =  { kw ~ "print" ~ print_expr_list? }
print_call         =  { kw ~ "print" ~ "(" ~ multiple_expr_list ~ ")" ~ !in_op }
simple_printf      =  { kw ~ "printf" ~ print_expr_list }
printf_call        =  { kw ~ "printf" ~ "(" ~ multiple_expr_list ~ ")" ~ !in_op }
output_redirection = _{
    truncate
  | append
  | pipe
}

truncate = { ">" ~ expr }
append   = { ">>" ~ expr }
pipe     = { "|" ~ expr }

print_expr_list    = _{ print_expr ~ ("," ~ opt_newline ~ print_expr)* }
expr_list          = _{ expr ~ ("," ~ opt_newline ~ expr)* }
multiple_expr_list = _{ expr ~ ("," ~ opt_newline ~ expr)+ }

primary = _{
    "(" ~ expr ~ ")"
  | ere
  | number
  | string
  | builtin_function_call
  | function_call
  | lvalue
}

array_element         = { name ~ "[" ~ expr_list ~ "]" }
function_call         = { func_name ~ "(" ~ expr_list? ~ ")" }
builtin_function_call = { builtin_func ~ ("(" ~ expr_list? ~ ")")? }

prefix_op = _{
    pre_inc
  | pre_dec
  | not
  | unary_plus
  | negate
}

pre_inc    = { "++" }
pre_dec    = { "--" }
not        = { "!" }
unary_plus = { "+" }
negate     = { "-" }

postfix_op = _{
    post_inc
  | post_dec
}

post_inc = { "++" }
post_dec = { "--" }

infix_op = _{
    pow
  | mul
  | div
  | modulus
  | add
  | binary_sub
  | comp_op
  | match_op
  | not_match
  | in_op
  | and
  | or
  | concat
}

pow        = { "^" }
mul        = { "*" }
div        = { "/" }
modulus    = { "%" }
add        = { "+" }
binary_sub = { "-" }
match_op   = { "~" }
not_match  = { "!~" }
and        = { "&&" ~ opt_newline }
or         = { "||" ~ opt_newline }
concat     = { "" }
in_op      = @{ "in" ~ !(letter | "_" | digit) }

comp_op = {
    le
  | lt
  | ge
  | gt
  | ne
  | eq
}

lt = { "<" }
le = { "<=" }
ne = { "!=" }
eq = { "==" }
gt = { ">" }
ge = { ">=" }

// A group with a top-level comma is never a primary, so trying the simple
// form first costs `(i, j) in a` one short failed parse, not a re-parse of
// every parenthesised expression.
binary_expr = {
    simple_binary_expr
  | multidimensional_in
}

multidimensional_in    = { "(" ~ multidimensional_index ~ ")" ~ "in" ~ name }
simple_binary_expr     = { operand ~ (piped_getline | infix_op ~ operand)* }
multidimensional_index = { multiple_expr_list }

ternary_expr = { binary_expr ~ ("?" ~ expr ~ ":" ~ expr)? }

assignment = { maybe_assignment ~ lvalue ~ assignment_op ~ expr }

// An assignment's target would otherwise be parsed twice when no assignment
// operator follows it, once here and once as an operand, and nested targets
// (a[a[a[1]]], $($(1))) twice per level.  This lookahead skips the attempt
// when the target's shape, scanned without parsing it, is followed by
// something else.  Anything the scan cannot read with confidence (a `/`
// that may begin a regular expression, a comment, `$++i`) fails the scan,
// and then the assignment is attempted as before.
maybe_assignment = _{ !(lvalue_shape ~ !assignment_op) }
lvalue_shape     = _{ name ~ subscript_shape? ~ !"[" | "$" ~ field_shape }
field_shape      = _{ "$" ~ field_shape | group_shape | name ~ subscript_shape? ~ !"[" | number }
subscript_shape  = @{ "[" ~ (string | subscript_shape | !("[" | "]" | "\"" | "/" | "#") ~ ANY)* ~ "]" }
group_shape      = @{ "(" ~ (string | group_shape | !("(" | ")" | "\"" | "/" | "#") ~ ANY)* ~ ")" }

assignment_op = {
    assign
  | add_assign
  | sub_assign
  | mul_assign
  | div_assign
  | mod_assign
  | pow_assign
}

assign     = { "=" }
add_assign = { "+=" }
sub_assign = { "-=" }
mul_assign = { "*=" }
div_assign = { "/=" }
mod_assign = { "%=" }
pow_assign = { "^=" }

// Alternatives that share a prefix are factored, never retried: a choice
// that re-parses a nested `( expr )` after a later failure makes parsing
// time exponential in the nesting depth.  So `ternary_expr` also stands
// for the plain expression without its `? :` tail.
expr = { assignment | ternary_expr }

operand = _{ prefix_op* ~ (getline | primary) ~ postfix_op? }

lvalue = {
    array_element
  | name
  | field_var
}

// `$` binds tighter than `++` and `--`: `$i++` increments the field, so
// the operand of `$` takes no increment of its own, except a field operand
// or one with a unary operator: `$$i++` is `$($i++)` and `$-i++` is
// `$(-(i++))`, as in gawk and mawk.  `nested_field` always takes the inner
// field, so the field is never parsed a second time as a primary.
field_var    = { "$" ~ (prefix_op+ ~ primary ~ postfix_op? | nested_field | primary) }
nested_field = { field_var ~ postfix_op? }

// `getline [var] [< file]` is an operand, so `getline > 0` compares its
// result and `getline x y` concatenates y to it.  As in gawk, the file
// name takes no operator that binds looser than `+` and `-`: `getline <
// "a" ".b"` is `(getline < "a") ".b"`.  `cmd | getline [var]` is an
// operator (`piped_getline`) that binds tighter than a comparison but
// looser than a concatenation.
getline         = { kw ~ "getline" ~ lvalue? ~ ("<" ~ getline_file)? }
getline_file    = { prefix_op* ~ primary ~ postfix_op? ~ (getline_file_op ~ prefix_op* ~ primary ~ postfix_op?)* }
getline_file_op = _{ pow | mul | div | modulus | add | binary_sub }
piped_getline   = { "|" ~ kw ~ "getline" ~ lvalue? }

print_infix_op           = _{
    pow
  | mul
  | div
  | modulus
  | add
  | binary_sub
  | match_op
  | not_match
  | in_op
  | and
  | or
  | concat
}
simple_binary_print_expr =  { operand ~ (print_infix_op ~ operand)* }
binary_print_expr        =  {
    simple_binary_print_expr
  | multidimensional_in
}

print_assignment   = { maybe_assignment ~ lvalue ~ assignment_op ~ print_expr }
ternary_print_expr = { binary_print_expr ~ ("?" ~ print_expr ~ ":" ~ print_expr)? }

print_expr = {
    print_assignment
  | ternary_print_expr
}
